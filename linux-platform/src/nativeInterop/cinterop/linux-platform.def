headers = sys/stat.h fcntl.h
package = linux.platform

---
#include <unistd.h>
#include <sys/syscall.h>
#include <linux/stat.h>

#ifndef __NR_statx
#define __NR_statx 332
#endif

static inline int linux_statx(
    int dirfd,
    const char *path,
    int flags,
    unsigned int mask,
    struct statx *buf
) {
    return syscall(
        __NR_statx,
        dirfd,
        path,
        flags,
        mask,
        buf
    );
}