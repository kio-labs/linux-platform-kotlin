headers = sys/stat.h fcntl.h
package = linux.platform
compilerOpts = \
    -I/usr/include \
    -I/usr/include/x86_64-linux-gnu

---
#include <unistd.h>
#include <sys/syscall.h>
#include <linux/stat.h>

static inline int linux_statx(
    int dirfd,
    const char *path,
    int flags,
    unsigned int mask,
    struct statx *buf
) {
    return syscall(
        SYS_statx,
        dirfd,
        path,
        flags,
        mask,
        buf
    );
}